    {
      "cell_type": "code",
      "source": [
        "embedding_cache = {}\n",
        "\n",
        "def get_embedding(text):\n",
        "    if text in embedding_cache:\n",
        "        return embedding_cache[text]\n",
        "\n",
        "    emb = model.encode([text])[0]\n",
        "    embedding_cache[text] = emb\n",
        "    return emb\n",
        "\n",
        "embeddings = np.array([get_embedding(c) for c in chunks])"
      ],
      "metadata": {
        "id": "1V3rYDuOQodh"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import faiss\n",
        "\n",
        "dim = embeddings.shape[1]\n",
        "index = faiss.IndexFlatL2(dim)\n",
        "\n",
        "index.add(embeddings)"
      ],
